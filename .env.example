# --- DATABASE ---
TIDB_HOST=gateway01.ap-southeast-1.prod.alicloud.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your-user.root
TIDB_PASSWORD=your-password
TIDB_DB=test
TIDB_CA_PATH=

# --- AUTH ---
SECRET_KEY=generate-a-secure-random-string

# --- RATE LIMITING ---
# Options: 
# - memory:// (Default, for development)
# - redis://localhost:6379 (For local Redis)
# - rediss://user:pass@host:port (For production Redis/Railway/Render)
RATE_LIMIT_STORAGE_URI=memory://

# Comma-separated list of allowed origins. 
# NO trailing slashes. NO wildcards.
# Example (Local): http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000
# Example (Vercel): https://ecommerce-website-shopease.vercel.app
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
