# TiDB / MySQL Configuration
TIDB_HOST=your-tidb-host.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your-user.root
TIDB_PASSWORD=your-password
TIDB_DB=test
TIDB_CA_PATH=

# Flask Configuration
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-this-with-a-very-secure-key

# Rate Limiter
# Use redis://localhost:6379 for production
RATE_LIMIT_STORAGE_URI=memory://

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://localhost:5173

# Environment
FLASK_ENV=development
PORT=5000
