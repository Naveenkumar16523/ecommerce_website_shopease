{
  "version": 2,
  "builds": [
    {
      "src": "backend/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/static/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/assets/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/frontend/static/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/index.html",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/(.*).html",
      "dest": "/frontend/$1.html"
    },
    {
      "src": "/mens",
      "dest": "/frontend/mens.html"
    },
    {
      "src": "/womens",
      "dest": "/frontend/womens.html"
    },
    {
      "src": "/kids",
      "dest": "/frontend/kids.html"
    },
    {
      "src": "/new-arrivals",
      "dest": "/frontend/new-arrivals.html"
    },
    {
      "src": "/top-selling",
      "dest": "/frontend/top-selling.html"
    },
    {
      "src": "/on-sale",
      "dest": "/frontend/on-sale.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
