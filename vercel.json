{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "static/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "app.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/index.html",
      "dest": "/index.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*).html",
      "dest": "/$1.html"
    },
    {
      "src": "/mens",
      "dest": "/mens.html"
    },
    {
      "src": "/womens",
      "dest": "/womens.html"
    },
    {
      "src": "/kids",
      "dest": "/kids.html"
    },
    {
      "src": "/new-arrivals",
      "dest": "/new-arrivals.html"
    },
    {
      "src": "/top-selling",
      "dest": "/top-selling.html"
    },
    {
      "src": "/on-sale",
      "dest": "/on-sale.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
